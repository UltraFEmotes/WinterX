{
  "format": "winterx.springys/2",
  "type": "tweak",
  "id": "me.example.codetweak",
  "name": "Code Tweak Example",
  "version": "0.1.0",
  "author": "WinterX contributors",
  "description": "Developer example: a native Settings page whose buttons execute this package's own JavaScript. Not included in the release repository.",
  "entry": "tweak/main.js",
  "settings": {
    "main": {
      "title": "Code Tweak Example",
      "sections": [{
        "title": "YOUR OWN JAVASCRIPT",
        "rows": [
          {"id": "hello", "type": "button", "title": "Run My Code"},
          {"id": "enabled", "type": "toggle", "title": "Example Preference"},
          {"id": "more", "type": "page", "title": "More", "page": "more"}
        ]
      }]
    },
    "pages": {
      "more": {
        "title": "More",
        "sections": [{
          "rows": [
            {"id": "save", "type": "button", "title": "Save a Tweak File"},
            {"id": "back", "type": "page", "title": "Example Main Page", "page": "main"}
          ]
        }]
      }
    }
  }
}
